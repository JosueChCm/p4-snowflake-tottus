{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Nombre de instancia de Data Factory",
            "defaultValue": "adf-tottus-p4-jc"
        },
        "ls_snowflake_privateKeyPassphrase": {
            "type": "secureString",
            "metadata": "Cadena protegida para \"privateKeyPassphrase\"de \"ls_snowflake\""
        },
        "ls_keyvault_properties_typeProperties_baseUrl": {
            "type": "string",
            "defaultValue": "https://kv-tottus-p4-jc.vault.azure.net/"
        },
        "ls_adls_lake_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://stdwtottusjc.dfs.core.windows.net/"
        },
        "ls_sql_oltp_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sql-tottus-jc-centralus.database.windows.net"
        },
        "ls_sql_oltp_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "tottus_oltp"
        },
        "ls_sql_oltp_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "tottusadmin"
        },
        "ls_snowflake_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "OPS_DB"
        },
        "ls_snowflake_properties_typeProperties_role": {
            "type": "string",
            "defaultValue": "ROL_ORQ"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/ls_keyvault')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "conexión al Key Vault",
                "annotations": [],
                "type": "AzureKeyVault",
                "typeProperties": {
                    "baseUrl": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_adls_lake')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "conexión al lake",
                "annotations": [],
                "type": "AzureBlobFS",
                "typeProperties": {
                    "url": "[parameters('ls_adls_lake_properties_typeProperties_url')]"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_parquet_bronze')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_adls_lake",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "tabla": {
                        "type": "string"
                    },
                    "carga_id": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "Parquet",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@concat(dataset().tabla, '.parquet')",
                            "type": "Expression"
                        },
                        "folderPath": {
                            "value": "@concat(dataset().tabla, '/carga=', dataset().carga_id)",
                            "type": "Expression"
                        },
                        "fileSystem": "bronze"
                    },
                    "compressionCodec": "snappy"
                },
                "schema": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_adls_lake')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_sql_oltp')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "conexión al OLTP",
                "annotations": [],
                "type": "AzureSqlDatabase",
                "typeProperties": {
                    "server": "[parameters('ls_sql_oltp_properties_typeProperties_server')]",
                    "database": "[parameters('ls_sql_oltp_properties_typeProperties_database')]",
                    "encrypt": "mandatory",
                    "trustServerCertificate": false,
                    "authenticationType": "SQL",
                    "userName": "[parameters('ls_sql_oltp_properties_typeProperties_userName')]",
                    "password": {
                        "type": "AzureKeyVaultSecret",
                        "store": {
                            "referenceName": "ls_keyvault",
                            "type": "LinkedServiceReference"
                        },
                        "secretName": "sql-admin-password"
                    },
                    "connectTimeout": 120,
                    "connectRetryCount": 3,
                    "connectRetryInterval": 10,
                    "commandTimeout": 600
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_keyvault')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_snowflake')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Snowflake JULTITQ-IC99482 con usuario de servicio SVC_ADF (llave RSA en Key Vault)",
                "annotations": [],
                "type": "SnowflakeV2",
                "typeProperties": {
                    "authenticationType": "KeyPair",
                    "accountIdentifier": "JULTITQ-IC99482",
                    "user": "SVC_ADF",
                    "database": "[parameters('ls_snowflake_properties_typeProperties_database')]",
                    "warehouse": "WH_TOTTUS",
                    "role": "[parameters('ls_snowflake_properties_typeProperties_role')]",
                    "privateKey": {
                        "type": "AzureKeyVaultSecret",
                        "store": {
                            "referenceName": "ls_keyvault",
                            "type": "LinkedServiceReference"
                        },
                        "secretName": "sf-adf-private-key"
                    },
                    "privateKeyPassphrase": {
                        "type": "SecureString",
                        "value": "[parameters('ls_snowflake_privateKeyPassphrase')]"
                    },
                    "useUtcTimestamps": false
                },
                "version": "1.1"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_keyvault')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_sql_tabla')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_sql_oltp",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "tabla": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "AzureSqlTable",
                "schema": [],
                "typeProperties": {
                    "schema": "dbo",
                    "table": {
                        "value": "@dataset().tabla",
                        "type": "Expression"
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_sql_oltp')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/pl_ingesta_bronze')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "fe_tablas",
                        "type": "ForEach",
                        "dependsOn": [],
                        "userProperties": [],
                        "typeProperties": {
                            "items": {
                                "value": "@pipeline().parameters.tablas",
                                "type": "Expression"
                            },
                            "batchCount": 2,
                            "activities": [
                                {
                                    "name": "cp_tabla",
                                    "type": "Copy",
                                    "dependsOn": [],
                                    "policy": {
                                        "timeout": "0.12:00:00",
                                        "retry": 3,
                                        "retryIntervalInSeconds": 60,
                                        "secureOutput": false,
                                        "secureInput": false
                                    },
                                    "userProperties": [],
                                    "typeProperties": {
                                        "source": {
                                            "type": "AzureSqlSource",
                                            "queryTimeout": "02:00:00",
                                            "partitionOption": "None"
                                        },
                                        "sink": {
                                            "type": "ParquetSink",
                                            "storeSettings": {
                                                "type": "AzureBlobFSWriteSettings"
                                            },
                                            "formatSettings": {
                                                "type": "ParquetWriteSettings"
                                            }
                                        },
                                        "enableStaging": false,
                                        "dataIntegrationUnits": 4,
                                        "translator": {
                                            "type": "TabularTranslator",
                                            "typeConversion": true,
                                            "typeConversionSettings": {
                                                "allowDataTruncation": true,
                                                "treatBooleanAsNumber": false
                                            }
                                        }
                                    },
                                    "inputs": [
                                        {
                                            "referenceName": "ds_sql_tabla",
                                            "type": "DatasetReference",
                                            "parameters": {
                                                "tabla": {
                                                    "value": "@item()",
                                                    "type": "Expression"
                                                }
                                            }
                                        }
                                    ],
                                    "outputs": [
                                        {
                                            "referenceName": "ds_parquet_bronze",
                                            "type": "DatasetReference",
                                            "parameters": {
                                                "tabla": {
                                                    "value": "@toLower(item())",
                                                    "type": "Expression"
                                                },
                                                "carga_id": {
                                                    "value": "@if(empty(pipeline().parameters.carga_id), convertFromUtc(pipeline().TriggerTime, 'SA Pacific Standard Time', 'yyyyMMdd_HHmmss'), pipeline().parameters.carga_id)",
                                                    "type": "Expression"
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "parameters": {
                    "carga_id": {
                        "type": "string"
                    },
                    "tablas": {
                        "type": "array",
                        "defaultValue": [
                            "Categorias",
                            "Subcategorias",
                            "Marcas",
                            "Proveedores",
                            "Productos",
                            "Formatos_Tienda",
                            "Sucursales",
                            "Empleados",
                            "Clientes",
                            "Metodos_Pago",
                            "Ventas",
                            "Detalle_Venta",
                            "Compras_Proveedor",
                            "Detalle_Compra",
                            "Devoluciones"
                        ]
                    }
                },
                "annotations": [],
                "lastPublishTime": "2026-10-19T01:52:16Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/ds_sql_tabla')]",
                "[concat(variables('factoryId'), '/datasets/ds_parquet_bronze')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/pl_p4_full')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Proyecto 4: corrida completa OLTP -> Bronze (ADF) -> Bronze Snowflake (full load) -> dbt (Silver, snapshots SCD2, Gold) con bitácora.",
                "activities": [
                    {
                        "name": "set_carga_id",
                        "description": "carga_id = fecha y hora de Lima (yyyyMMdd_HHmmss)",
                        "type": "SetVariable",
                        "dependsOn": [],
                        "policy": {
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "variableName": "carga_id",
                            "value": {
                                "value": "@convertFromUtc(utcNow(), 'SA Pacific Standard Time', 'yyyyMMdd_HHmmss')",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "sc_log_inicio",
                        "description": "Bitácora: inicio de la corrida",
                        "type": "Script",
                        "dependsOn": [
                            {
                                "activity": "set_carga_id",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.02:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "linkedServiceName": {
                            "referenceName": "ls_snowflake",
                            "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                            "scripts": [
                                {
                                    "type": "NonQuery",
                                    "text": {
                                        "value": "@concat('CALL OPS_DB.ADMIN.SP_REGISTRAR_CORRIDA(''', variables('carga_id'), ''', ''', pipeline().RunId, ''', ''INICIADA'', ''', 'pl_p4_full', ''')')",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "scriptBlockExecutionTimeout": "00:05:00"
                        }
                    },
                    {
                        "name": "ep_ingesta_bronze",
                        "description": "Copia las 15 tablas del OLTP al contenedor bronze",
                        "type": "ExecutePipeline",
                        "dependsOn": [
                            {
                                "activity": "sc_log_inicio",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "pipeline": {
                                "referenceName": "pl_ingesta_bronze",
                                "type": "PipelineReference"
                            },
                            "waitOnCompletion": true,
                            "parameters": {
                                "carga_id": {
                                    "value": "@variables('carga_id')",
                                    "type": "Expression"
                                }
                            }
                        }
                    },
                    {
                        "name": "sc_cargar_bronze",
                        "description": "Full load en Snowflake: TRUNCATE + COPY INTO de la corrida actual",
                        "type": "Script",
                        "dependsOn": [
                            {
                                "activity": "ep_ingesta_bronze",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.02:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "linkedServiceName": {
                            "referenceName": "ls_snowflake",
                            "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                            "scripts": [
                                {
                                    "type": "NonQuery",
                                    "text": {
                                        "value": "@concat('CALL BRONZE_DB.RAW.SP_CARGAR_BRONZE(''', variables('carga_id'), ''')')",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "scriptBlockExecutionTimeout": "00:30:00"
                        }
                    },
                    {
                        "name": "sc_dbt_build",
                        "description": "dbt build en Snowflake: Silver, snapshots SCD2, Gold y tests",
                        "type": "Script",
                        "dependsOn": [
                            {
                                "activity": "sc_cargar_bronze",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.02:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "linkedServiceName": {
                            "referenceName": "ls_snowflake",
                            "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                            "scripts": [
                                {
                                    "type": "NonQuery",
                                    "text": "CALL OPS_DB.ADMIN.SP_EJECUTAR_DBT('build --target prod')"
                                }
                            ],
                            "scriptBlockExecutionTimeout": "01:00:00"
                        }
                    },
                    {
                        "name": "sc_log_ok",
                        "description": "Bitácora: fin correcto",
                        "type": "Script",
                        "dependsOn": [
                            {
                                "activity": "sc_dbt_build",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.02:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "linkedServiceName": {
                            "referenceName": "ls_snowflake",
                            "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                            "scripts": [
                                {
                                    "type": "NonQuery",
                                    "text": {
                                        "value": "@concat('CALL OPS_DB.ADMIN.SP_REGISTRAR_CORRIDA(''', variables('carga_id'), ''', ''', pipeline().RunId, ''', ''OK'', ''', 'corrida completa', ''')')",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "scriptBlockExecutionTimeout": "00:05:00"
                        }
                    },
                    {
                        "name": "sc_log_error",
                        "description": "Bitácora: la corrida falló en algún paso",
                        "type": "Script",
                        "dependsOn": [
                            {
                                "activity": "sc_dbt_build",
                                "dependencyConditions": [
                                    "Failed",
                                    "Skipped"
                                ]
                            }
                        ],
                        "policy": {
                            "timeout": "0.02:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "linkedServiceName": {
                            "referenceName": "ls_snowflake",
                            "type": "LinkedServiceReference"
                        },
                        "typeProperties": {
                            "scripts": [
                                {
                                    "type": "NonQuery",
                                    "text": {
                                        "value": "@concat('CALL OPS_DB.ADMIN.SP_REGISTRAR_CORRIDA(''', variables('carga_id'), ''', ''', pipeline().RunId, ''', ''ERROR'', ''', 'revisar el monitor de ADF', ''')')",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "scriptBlockExecutionTimeout": "00:05:00"
                        }
                    },
                    {
                        "name": "fail_corrida",
                        "type": "Fail",
                        "dependsOn": [
                            {
                                "activity": "sc_log_error",
                                "dependencyConditions": [
                                    "Succeeded"
                                ]
                            }
                        ],
                        "userProperties": [],
                        "typeProperties": {
                            "message": {
                                "value": "@concat('La corrida ', variables('carga_id'), ' falló. Ver LOG_CORRIDAS y el monitor de ADF.')",
                                "type": "Expression"
                            },
                            "errorCode": "P4-001"
                        }
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "variables": {
                    "carga_id": {
                        "type": "String"
                    }
                },
                "annotations": [
                    "proyecto4",
                    "full-load",
                    "snapshot-scd2"
                ],
                "lastPublishTime": "2026-10-05T21:22:14Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_snowflake')]",
                "[concat(variables('factoryId'), '/pipelines/pl_ingesta_bronze')]"
            ]
        }
    ]
}