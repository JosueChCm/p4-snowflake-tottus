{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Nombre de instancia de Data Factory",
            "defaultValue": "adf-tottus-p4-jc"
        },
        "ls_keyvault_properties_typeProperties_baseUrl": {
            "type": "string",
            "defaultValue": "https://kv-tottus-p4-jc.vault.azure.net/"
        },
        "ls_adls_lake_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://stdwtottusjc.dfs.core.windows.net/"
        },
        "ls_sql_oltp_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sql-tottus-jc-centralus.database.windows.net"
        },
        "ls_sql_oltp_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "tottus_oltp"
        },
        "ls_sql_oltp_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "tottusadmin"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-tottus-p4-jc_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "ls_keyvault_properties_typeProperties_baseUrl": {
                        "value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
                    },
                    "ls_adls_lake_properties_typeProperties_url": {
                        "value": "[parameters('ls_adls_lake_properties_typeProperties_url')]"
                    },
                    "ls_sql_oltp_properties_typeProperties_server": {
                        "value": "[parameters('ls_sql_oltp_properties_typeProperties_server')]"
                    },
                    "ls_sql_oltp_properties_typeProperties_database": {
                        "value": "[parameters('ls_sql_oltp_properties_typeProperties_database')]"
                    },
                    "ls_sql_oltp_properties_typeProperties_userName": {
                        "value": "[parameters('ls_sql_oltp_properties_typeProperties_userName')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}