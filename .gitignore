# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# (el archivo .terraform.lock.hcl SÍ se versiona)

# ---- Llaves y secretos ----
*.p8
*.pem
*.key
*.pub
.env
.env.*
secrets/

# ---- Python ----
.venv*/
venv/
__pycache__/
*.pyc

